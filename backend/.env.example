# 环境变量配置文件
# 复制此文件为 .env 并填入真实的 API Key

# ModelScope API Key（用于云端大模型）
# 获取方式：访问 https://www.modelscope.cn/my/myaccesstoken 创建 API Token
MODELSCOPE_API_KEY=your_api_key_here

# ModelScope OpenAI 兼容接口地址与模型
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1
CHAT_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
LLM_TIMEOUT=90

# RAG 检索参数
RAG_TOP_K=3
RAG_MIN_SCORE=0.35

# 长期记忆参数
MEMORY_TOP_K=5
MEMORY_RECENCY_WEIGHT=0.3
MEMORY_EMOTION_WEIGHT=0.2
MEMORY_INACTIVE_DAYS=90

# 数据库配置（可选）
DATABASE_URL=sqlite:///./data/xinyu.db

# JWT 密钥（可选，默认会自动生成）
SECRET_KEY=your_secret_key_here
